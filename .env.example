# GEMINI_API_KEY: Optional, only needed if a feature explicitly requests a Gemini API key.
# AI Studio automatically injects secrets at runtime when configured.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# OPENAI_API_KEY: Required for ChatGPT-powered responses in BharatTube's Chhotu AI Assistant.
# Configure your real key in Google AI Studio Secrets (never commit actual secrets here).
OPENAI_API_KEY=OPENAI_API_KEY_DEFAULT_VALUE

